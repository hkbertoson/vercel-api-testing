---
import SolidFeedbackForm from "../components/solid/FeedbackForm";
import PreactFeedbackForm from "../components/preact/FeedbackForm";
import ReactFeedbackForm from "../components/react/FeedbackForm";
import VueFeedbackForm from "../components/vue/FeedbackForm.vue";
import SvelteFeedbackForm from "../components/svelte/FeedbackForm.svelte";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1>Solid Form</h1>
  <SolidFeedbackForm client:load />
  <h1>Preact Form</h1>
  <PreactFeedbackForm client:load />
  <h1>Vue Form</h1>
  <VueFeedbackForm client:load />
  <h1>React Form</h1>
  <ReactFeedbackForm client:load />
  <h1>Svelte Form</h1>
  <SvelteFeedbackForm client:load />
</Layout>
